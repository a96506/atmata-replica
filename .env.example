# InsForge — copy to .env.local and fill from:
#   npx @insforge/cli current
#   npx @insforge/cli secrets get ANON_KEY
# API key lives in .insforge/project.json (gitignored)

NEXT_PUBLIC_INSFORGE_URL=https://YOUR_APPKEY.REGION.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=anon_...
# Local only. On Vercel leave unset (or set real https origin) — code falls back to VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL so invites are not stuck on localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only (do not prefix NEXT_PUBLIC_)
INSFORGE_URL=https://YOUR_APPKEY.REGION.insforge.app
INSFORGE_API_KEY=ik_...

# Demo owner bootstrap (scripts/bootstrap-demo-owner.mjs) — set in shell or local env; do not commit passwords
DEMO_OWNER_EMAIL=
DEMO_OWNER_NAME=
# DEMO_OWNER_PASSWORD — supply via read -s / export only; never commit

# Platform admin (scripts/bootstrap-platform-admin.mjs) — never use as VERIFY_B_*
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_NAME=
# PLATFORM_ADMIN_PASSWORD — supply via read -s / export only; never commit

# Verify tenants (scripts/bootstrap-verify-tenants.mjs) — separate companies A/B; never dual-hat platform as B
# VERIFY_A_OWNER_EMAIL=
# VERIFY_A_OWNER_PASSWORD=
# VERIFY_A_VIEWER_EMAIL=
# VERIFY_A_VIEWER_PASSWORD=
# VERIFY_B_OWNER_EMAIL=
# VERIFY_B_OWNER_PASSWORD=
# VERIFY_ALLOW_MUTATION=erp-backend-v1
# VERIFY_RUN_ID=vf_YYYYMMDD_xxxxxx

# HMAC secret for company-admin invitation tokens (server-only, >=32 chars)
INVITATION_TOKEN_SECRET=

# Public app origin used in invitation emails (preview/production URL in deploy)
# APP_URL is also stored as an InsForge function secret for email-send

